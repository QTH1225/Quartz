filters:
  and:
    - file.basename != "index"
    - file.ext != "base"
    - file.ext != "pdf"
    - file.basename != "Template"
views:
  - type: table
    name: 表格
    filters:
      and:
        - '!file.inFolder("Attachments")'
    order:
      - file.name
      - title
      - author
      - tags
      - draft
    sort:
      - property: file.folder
        direction: ASC
      - property: tags
        direction: DESC
    columnSize:
      file.name: 338
      note.title: 213
      file.folder: 239
      note.tags: 309
