{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackyzha0/quartz.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "dev": "node quartz/bootstrap-cli.mjs build --serve",
    "build:i18n": "node quartz/scripts/build-i18n.mjs",
    "check:content": "node quartz/scripts/audit-content.mjs",
    "check:bilingual": "node quartz/scripts/audit-bilingual.mjs",
    "check:language-switch": "node quartz/scripts/audit-language-switch.mjs",
    "check:built-links": "node quartz/scripts/audit-built-links.mjs",
    "check:built-domain": "node quartz/scripts/audit-built-domain.mjs",
    "check:rss": "node quartz/scripts/audit-rss.mjs",
    "check:site-stats": "node --test quartz/plugins/site-stats/site-stats.test.mjs && node quartz/scripts/audit-site-stats.mjs",
    "check:comments": "node --test quartz/plugins/twikoo-comments/twikoo-comments.test.mjs && node quartz/scripts/audit-comments.mjs",
    "check:word-count": "node --test quartz/plugins/published-word-count/published-word-count.test.mjs && node quartz/scripts/audit-site-stats.mjs",
    "check:recent-notes": "node --test quartz/plugins/mobile-recent-notes/mobile-recent-notes.test.mjs quartz/styles/explorer-collapse.test.mjs && node quartz/scripts/audit-recent-notes.mjs",
    "format:content-frontmatter": "node quartz/scripts/normalize-content-frontmatter.mjs",
    "patch-quartz-date-format": "node quartz/scripts/patch-quartz-date-format.mjs",
    "postinstall": "node quartz/scripts/patch-quartz-date-format.mjs",
    "docs": "npx quartz build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "npx tsx ./quartz/plugins/loader/install-plugins.ts",
    "prebuild": "npm run install-plugins"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@floating-ui/dom": "^1.7.4",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "1.2.0",
    "@quartz-community/alias-redirects": "^1.0.0",
    "@quartz-community/article-title": "^1.0.0",
    "@quartz-community/backlinks": "^1.0.0",
    "@quartz-community/bases-page": "^1.0.0",
    "@quartz-community/breadcrumbs": "^1.0.0",
    "@quartz-community/canvas-page": "^1.0.0",
    "@quartz-community/citations": "^1.0.0",
    "@quartz-community/cname": "^1.0.0",
    "@quartz-community/comments": "^1.0.0",
    "@quartz-community/content-index": "^1.0.0",
    "@quartz-community/content-meta": "^1.0.0",
    "@quartz-community/content-page": "^1.0.0",
    "@quartz-community/crawl-links": "^1.0.0",
    "@quartz-community/created-modified-date": "^1.0.1",
    "@quartz-community/darkmode": "^1.0.0",
    "@quartz-community/description": "^1.0.0",
    "@quartz-community/encrypted-pages": "^1.0.0",
    "@quartz-community/explicit-publish": "^1.0.0",
    "@quartz-community/explorer": "^1.0.0",
    "@quartz-community/favicon": "^1.0.0",
    "@quartz-community/folder-page": "^1.0.0",
    "@quartz-community/footer": "^1.0.0",
    "@quartz-community/github-flavored-markdown": "^1.0.0",
    "@quartz-community/graph": "^1.0.0",
    "@quartz-community/hard-line-breaks": "^1.0.0",
    "@quartz-community/latex": "^1.0.0",
    "@quartz-community/note-properties": "^1.0.0",
    "@quartz-community/obsidian-flavored-markdown": "^1.0.0",
    "@quartz-community/og-image": "^1.0.0",
    "@quartz-community/ox-hugo": "^1.0.0",
    "@quartz-community/page-title": "^1.0.0",
    "@quartz-community/quartz-fonts": "^1.0.0",
    "@quartz-community/reader-mode": "^1.0.0",
    "@quartz-community/remove-draft": "^1.0.0",
    "@quartz-community/roam": "^1.0.0",
    "@quartz-community/search": "^1.0.0",
    "@quartz-community/spacer": "^1.0.0",
    "@quartz-community/stacked-pages": "^1.0.0",
    "@quartz-community/syntax-highlighting": "^1.0.1",
    "@quartz-community/table-of-contents": "^1.0.0",
    "@quartz-community/tag-list": "^1.0.0",
    "@quartz-community/tag-page": "^1.0.0",
    "@quartz-community/unlisted-pages": "^1.0.0",
    "@quartz-themes/core": "^2.0.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.6.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.4",
    "hast-util-from-html": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isomorphic-git": "^1.44.2",
    "lightningcss": "^1.31.1",
    "micromorph": "^0.4.5",
    "minimatch": "^10.2.6",
    "preact": "^11.0.1",
    "preact-render-to-string": "^6.8.0",
    "pretty-bytes": "^7.2.0",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "serve-handler": "^6.1.6",
    "sharp": "^0.35.5",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@quartz-community/types": "^1.0.0",
    "@quartz-community/utils": "^1.0.1",
    "@types/hast": "^3.0.4",
    "@types/node": "^26.6.5",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.2",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@myriaddreamin/typst-ts-node-compiler-win32-x64-msvc": "^0.7.0"
  }
}
