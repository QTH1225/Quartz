{
  "name": "language-switch",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js"
  },
  "quartz": {
    "name": "language-switch",
    "displayName": "Language Switch",
    "description": "Switch between localized Quartz site builds.",
    "version": "1.0.0",
    "category": "component",
    "quartzVersion": ">=5.0.0",
    "defaultOptions": {
      "roots": {
        "zh": "/",
        "en": "/en/"
      },
      "labels": {
        "zh": "中",
        "en": "EN"
      }
    },
    "components": {
      "LanguageSwitch": {
        "displayName": "Language Switch",
        "description": "Language switch link for bilingual sites.",
        "version": "1.0.0",
        "defaultPosition": "left",
        "defaultPriority": 37
      }
    }
  }
}
